NODE_ENV=development
PORT=3000

DATABASE_URL="mysql://username:password@localhost:3306/lv_cube"

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

WECHAT_APPID=your-wechat-appid
WECHAT_APP_SECRET=your-wechat-app-secret

WECHAT_PAY_MCH_ID=your-mch-id
WECHAT_PAY_API_KEY=your-api-key
WECHAT_PAY_CERT_PATH=/path/to/apiclient_cert.pem
WECHAT_PAY_KEY_PATH=/path/to/apiclient_key.pem

MAP_PROVIDER=tencent
MAP_KEY=your-map-key

OSS_PROVIDER=aliyun
OSS_ACCESS_KEY_ID=your-access-key
OSS_ACCESS_KEY_SECRET=your-access-secret
OSS_BUCKET=lv-cube
OSS_REGION=oss-cn-hangzhou
