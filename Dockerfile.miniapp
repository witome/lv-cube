FROM node:20-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@9

COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY packages/miniapp ./packages/miniapp

RUN pnpm install --frozen-lockfile 2>/dev/null || pnpm install

RUN cd packages/miniapp && pnpm build:h5

FROM nginx:alpine AS runner

COPY --from=builder /app/packages/miniapp/dist/build/h5 /usr/share/nginx/html

RUN cat > /tmp/nginx.conf.tpl << 'NGINXEOF'
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    location / {
        try_files $uri $uri/ /index.html;
    }
    location /api/ {
        proxy_pass ${API_BASE_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
NGINXEOF

EXPOSE 80

CMD ["sh", "-c", "envsubst '${API_BASE_URL}' < /tmp/nginx.conf.tpl > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
